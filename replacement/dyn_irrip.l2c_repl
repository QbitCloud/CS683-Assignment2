#include "cache.h"
#include <climits>
#include <vector>
#include <algorithm> 

#define maxRRPV 3

// partition parameter to partition the no of sets 
#define SET_PARTITION 256

// parameter for threshold
#define THRESHOLD 0.25

uint32_t l2_rrpv[L2C_SET][L2C_WAY];

// defining Leader sets 
vector<int> LEADERS = {77,29,191,222,1};

// global veriable that tells is our currunt policy is IRRIP or not
bool IRRIP;

// defining the statistical parameters/counters for decision making
uint64_t rrip_total_access;
uint64_t rrip_total_miss;
uint64_t rrip_data_access;
uint64_t rrip_data_miss;
uint64_t rrip_inst_miss;
uint64_t rrip_inst_access;

// helper funtion headers
uint32_t find_victim_rrip(uint32_t set);
uint32_t find_victim_irrip(uint32_t set, const BLOCK *current_set);
void l2c_update_replacement_state_rrip(uint32_t set, uint32_t way, uint8_t hit, uint8_t isInstruction, bool isNormal, bool isPrefetch);
void l2c_update_replacement_state_irrip(uint32_t set, uint32_t way, uint8_t hit, uint8_t isInstruction, bool isPrefetch);
void update_POLICY();

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize DYN-IRRIP state for L2C" << endl;

    // taking DYN-IRRIP by on starting phase
    IRRIP = true;

    // counter init
    rrip_total_access = 0;
    rrip_total_miss = 0;
    rrip_data_access = 0;
    rrip_data_miss = 0;
    rrip_inst_miss = 0;
    rrip_inst_access = 0;

    for (int i=0; i<L2C_SET; i++) {
        for (int j=0; j<L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    // leader set selection logic 
    // using find to avoid so many if else conditions 
    // if it is leader set than finding victiom based on rrip only
    if(find(LEADERS.begin(), LEADERS.end(), set % SET_PARTITION) != LEADERS.end()) 
        return find_victim_rrip(set);
    else {

        // if not leader than find victim based on currunt policy
        if(!IRRIP)
            return find_victim_rrip(set);
        else 
            return find_victim_irrip(set,current_set);
    }
}

void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit)
{
    string TYPE_NAME;
    if (type == LOAD)
        TYPE_NAME = "LOAD";
    else if (type == RFO)
        TYPE_NAME = "RFO";
    else if (type == PREFETCH)
        TYPE_NAME = "PF";
    else if (type == WRITEBACK)
        TYPE_NAME = "WB";
    else if (type == LOAD_TRANSLATION)
        TYPE_NAME = "L_TN";
    else if (type == PREFETCH_TRANSLATION)
        TYPE_NAME = "P_TN";
    else if (type == TRANSLATION_FROM_L1D)
        TYPE_NAME = "TN_L1D";
    else
        assert(0);

    if (hit)
        TYPE_NAME += "_HIT";
    else
        TYPE_NAME += "_MISS";

    if ((type == WRITEBACK) && ip)
        assert(0);

    // uncomment this line to see the L2C accesses
    // cout << "CPU: " << cpu << "  L2C " << setw(9) << TYPE_NAME << " set: " << setw(5) << set << " way: " << setw(2) << way;
    // cout << hex << " paddr: " << setw(12) << paddr << " ip: " << setw(8) << ip << " victim_addr: " << victim_addr << dec << endl;

    // extracting that the type of req is prefetch or not
    bool isPrefetch = (type == PREFETCH);
    
    // same goes with here 
    // applied leader set logic and if leader then do based on rrip 
    // else do based on currunt policy
    if(find(LEADERS.begin(), LEADERS.end(), set % SET_PARTITION) != LEADERS.end())
        l2c_update_replacement_state_rrip(set, way, hit, block[set][way].instruction, false, isPrefetch);
    else {
        if(!IRRIP)
            l2c_update_replacement_state_rrip(set, way, hit, block[set][way].instruction, true, isPrefetch);
        else 
            l2c_update_replacement_state_irrip(set, way, hit, block[set][way].instruction, isPrefetch);
    }
}

void CACHE::l2c_replacement_final_stats()
{

}

// just replecated victim selection logic from given rrip file
uint32_t find_victim_rrip(uint32_t set)
{
    while (1)
    {
        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                return i;

        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    assert(0);
    return 0;
}

// replecated victim selection from IRRIP 
// if data at 3 evict 
// if data at 2 and instr at 3 still evict data from 2
// if data at <2 and instr at 3 then only evict instr
uint32_t find_victim_irrip(uint32_t set, const BLOCK *current_set)
{
    while (1)
    {
        int inst_maxRRPV_index = -1;

        for (int i=0; i<L2C_WAY; i++)
            if (l2_rrpv[set][i] == maxRRPV)
                {
                    if(!current_set[i].instruction)
                        return i;
                    else {
                        if(inst_maxRRPV_index == -1)
                            inst_maxRRPV_index = i;
                    }
                }

        if(inst_maxRRPV_index != -1) {
            for (int i=0; i<L2C_WAY; i++)
                if (l2_rrpv[set][i] == maxRRPV-1)
                    if(!current_set[i].instruction)
                        return i;
            return inst_maxRRPV_index;    
        }

        for (int i=0; i<L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    // WE SHOULD NOT REACH HERE
    assert(0);
    return 0;
}

// replecated rrip update logic from given file 
// add functionality for ledear request and normal request
// if leader req than we have to update the counters 
void l2c_update_replacement_state_rrip(uint32_t set, uint32_t way, uint8_t hit, uint8_t isInstruction, bool isNormal, bool isPrefetch) 
{
    if (hit)
        l2_rrpv[set][way] = 0;
    else {
        l2_rrpv[set][way] = maxRRPV-1;
        if(!isNormal) {
            rrip_total_miss++;
            if(!isInstruction) {
                rrip_data_miss++;
            } else {
                rrip_inst_miss++;
            }
        }
    }
    if(!isNormal) {
        rrip_total_access++;
        if(!isInstruction) {
            rrip_data_access++;
        } else {
            rrip_inst_access++;
        }
    }
    update_POLICY();
}

// IRRIP updation logic 
// insert : data 3, instr 2
// hit promotion : data: curruntRRPV - 1, instr: 0
// if block is prefetched then insert at 2
void l2c_update_replacement_state_irrip(uint32_t set, uint32_t way, uint8_t hit, uint8_t isInstruction, bool isPrefetch) 
{
    if (hit) {
        if (isInstruction) {
            l2_rrpv[set][way] = 0;
        }
        else {
            if (l2_rrpv[set][way] > 0)
                l2_rrpv[set][way]--;
        }
    }
    else {
        if (isInstruction || isPrefetch)
            l2_rrpv[set][way] = maxRRPV-1;   // instruction or prefetched block
        else 
            l2_rrpv[set][way] = maxRRPV;     // demand data block
    }
}

// policy updation logic
// based on diffrent designs and expriments we only comparing ratios of inst or data misses over total misses
// we tried PSEL and diffrent techniques also but we got best performace using this logic 
// also we have done diffrent threshold sensitivity analysis 
// and got 0.25 as best threshold
void update_POLICY()
{
    if (rrip_total_access == 0 || rrip_total_miss == 0)  
        return;

    double inst_ratio =
        (double)(rrip_inst_miss) / (rrip_total_miss);

    double data_ratio =
        (double)(rrip_data_miss) / (rrip_total_miss);

    if (!IRRIP) {
        if (inst_ratio > THRESHOLD)
            IRRIP = true;
    }
    else {
        if (inst_ratio < THRESHOLD || data_ratio > 0.85)
            IRRIP = false;
    }
}